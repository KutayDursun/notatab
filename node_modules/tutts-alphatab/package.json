{
  "name": "tutts-alphatab",
  "version": "0.1.0",
  "description": "Pure TabData to alphaTex adapter for tutts.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/madisonrickert/tutts.git",
    "directory": "packages/alphatab"
  },
  "homepage": "https://github.com/madisonrickert/tutts/tree/main/packages/alphatab",
  "bugs": "https://github.com/madisonrickert/tutts/issues",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=18"
  },
  "author": "Madison Rickert <m@madisonrickert.com>",
  "keywords": [
    "guitar",
    "tablature",
    "tab",
    "alphatab",
    "alphatex",
    "midi",
    "music"
  ],
  "peerDependencies": {
    "tutts": "^0.1.0"
  },
  "devDependencies": {
    "@coderline/alphatab": "^1.8.0",
    "@types/node": "^22.7.0",
    "tsup": "^8.3.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0",
    "tutts": "0.1.0"
  },
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  }
}