{
  "name": "tutts",
  "version": "0.1.0",
  "description": "Renderer-neutral MIDI to guitar-tab fingering engine (TypeScript port of tuttut).",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/madisonrickert/tutts.git",
    "directory": "packages/core"
  },
  "homepage": "https://github.com/madisonrickert/tutts/tree/main/packages/core",
  "bugs": "https://github.com/madisonrickert/tutts/issues",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=18"
  },
  "author": "Madison Rickert <m@madisonrickert.com>",
  "keywords": [
    "guitar",
    "tablature",
    "tab",
    "midi",
    "music",
    "hmm",
    "viterbi",
    "fingering",
    "ableton",
    "alphatab"
  ],
  "devDependencies": {
    "@types/node": "^22.7.0",
    "tsup": "^8.3.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  },
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "parity": "tsx parity/run-parity.ts"
  }
}